@page "/admin/sessions"
@using CinemaAdmin.Components.Services
@inject SessionsService SessionsService

<h1>Sessions</h1>

<div class="admin-panel">
    <div class="admin-form">
        <h3>Create / Edit Session</h3>
        <!-- TODO: dropdowns for MovieId and HallId -->
        <input class="form-control" placeholder="Movie Id"/>
        <input class="form-control" placeholder="Hall Id"/>
        <input class="form-control" placeholder="Start Time (yyyy-MM-dd HH:mm)"/>
        <input class="form-control" placeholder="Ticket Price"/>
        <button class="btn btn-primary">Save</button>
    </div>

    <div class="admin-list">
        <h3>Upcoming Sessions</h3>
        <table class="table table-dark table-striped">
            <thead>
            <tr>
                <th>Id</th><th>Start</th><th>Movie</th><th>Hall</th><th>Price</th><th></th>
            </tr>
            </thead>
            <tbody>
            <!-- TODO: render rows -->
            </tbody>
        </table>
    </div>
</div>

