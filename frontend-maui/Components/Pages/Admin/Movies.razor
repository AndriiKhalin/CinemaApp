@page "/admin/movies"
@using CinemaAdmin.Components.Services
@inject MoviesService MoviesService

<h1>Movies</h1>

<div class="admin-panel">
    <div class="admin-form">
        <h3>Create / Edit Movie</h3>

        <!-- TODO: bind to MovieUpsertModel -->
        <input class="form-control" placeholder="Title"/>
        <input class="form-control" placeholder="Genre"/>
        <input class="form-control" placeholder="Duration (min)"/>
        <input class="form-control" placeholder="Image URL"/>
        <textarea class="form-control" placeholder="Description"></textarea>

        <button class="btn btn-primary">Save</button>
        <button class="btn btn-secondary">Clear</button>
    </div>

    <div class="admin-list">
        <h3>All Movies</h3>

        <!-- TODO: load list on init -->
        <table class="table table-dark table-striped">
            <thead>
            <tr>
                <th>Id</th><th>Title</th><th>Genre</th><th>Duration</th><th></th>
            </tr>
            </thead>
            <tbody>
            <!-- TODO: render rows, edit/delete actions -->
            </tbody>
        </table>
    </div>
</div>

